{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "fecha",
  "fuente",
  "detalle"
 ],
 "properties": {
  "fecha": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "fuente": {
   "type": "string"
  },
  "detalle": {
   "type": "string"
  }
 }
}
