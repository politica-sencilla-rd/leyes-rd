{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "fuentes"
 ],
 "properties": {
  "_nota": {
   "type": "string"
  },
  "fuentes": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "nombre",
     "estado",
     "fallos_seguidos"
    ],
    "properties": {
     "nombre": {
      "type": "string"
     },
     "seccion": {
      "type": "string"
     },
     "datos_al": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
     },
     "revisado_el": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "estado": {
      "enum": [
       "ok",
       "parcial",
       "sin_respuesta",
       "roto",
       "sin_revisar",
       "sin_clave"
      ]
     },
     "fallos_seguidos": {
      "type": "integer",
      "minimum": 0
     },
     "url_fuente": {
      "type": "string"
     },
     "retraso": {
      "type": "string"
     }
    }
   }
  }
 }
}
