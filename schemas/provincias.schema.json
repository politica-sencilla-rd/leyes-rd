{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "provincias"
 ],
 "properties": {
  "provincias": {
   "type": "array",
   "minItems": 32,
   "items": {
    "type": "object",
    "required": [
     "nombre",
     "lideres"
    ],
    "properties": {
     "nombre": {
      "type": "string"
     },
     "lideres": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "cargo",
        "nombre"
       ],
       "properties": {
        "cargo": {
         "type": "string"
        },
        "nombre": {
         "type": "string",
         "minLength": 2
        },
        "asistencia": {
         "type": "object",
         "required": [
          "presentes",
          "total"
         ],
         "properties": {
          "presentes": {
           "type": [
            "integer",
            "null"
           ],
           "minimum": 0
          },
          "total": {
           "type": "integer",
           "minimum": 0
          },
          "periodo": {
           "type": "string"
          },
          "fuente": {
           "type": "string"
          },
          "datos_al": {
           "type": "string",
           "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "nota": {
           "type": "string"
          }
         }
        },
        "comisiones": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "iniciativas_propuestas": {
         "type": "integer",
         "minimum": 0
        },
        "cargo_hasta": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
       }
      }
     }
    }
   }
  }
 }
}
