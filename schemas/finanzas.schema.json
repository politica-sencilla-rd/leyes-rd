{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "metricas"
 ],
 "properties": {
  "metricas": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "titulo",
     "valor",
     "fuente",
     "url"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "auto": {
      "type": "object",
      "required": [
       "valor_num",
       "valor_texto",
       "periodo",
       "periodo_iso",
       "url",
       "fuente",
       "texto",
       "comparacion"
      ],
      "properties": {
       "valor_num": {
        "type": "number"
       },
       "anterior_num": {
        "type": "number"
       },
       "valor_texto": {
        "type": "string"
       },
       "periodo": {
        "type": "string"
       },
       "periodo_iso": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}$"
       },
       "url": {
        "type": "string",
        "pattern": "^https?://"
       },
       "url_pagina": {
        "type": "string",
        "pattern": "^https?://"
       },
       "fuente": {
        "type": "string"
       },
       "texto": {
        "type": "string"
       },
       "comparacion": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "comparaciones_derivadas": {
   "type": "object"
  },
  "poblacion": {
   "type": "object"
  }
 }
}
