{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "resumenes"
 ],
 "properties": {
  "_nota": {
   "type": "string"
  },
  "resumenes": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "tipo",
     "estado",
     "fuente_url",
     "fuente_sha256",
     "modelo_escritor",
     "modelo_revisor",
     "checks_pasados",
     "checks_total",
     "fecha"
    ],
    "properties": {
     "tipo": {
      "enum": [
       "titulo_voto",
       "proyecto",
       "ley"
      ]
     },
     "estado": {
      "const": "verificado"
     },
     "estado_ley": {
      "type": [
       "string",
       "null"
      ]
     },
     "fuente_url": {
      "type": "string"
     },
     "fuente_nombre": {
      "type": "string"
     },
     "fuente_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "modelo_escritor": {
      "type": "string"
     },
     "modelo_revisor": {
      "type": "string"
     },
     "checks_pasados": {
      "type": "integer",
      "minimum": 1
     },
     "checks_total": {
      "type": "integer",
      "minimum": 1
     },
     "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "titulo_facil": {
      "type": "string",
      "maxLength": 140,
      "minLength": 1
     },
     "que_es": {
      "type": "string",
      "minLength": 1
     },
     "por_que": {
      "type": "string",
      "minLength": 1
     },
     "te_afecta": {
      "type": "string",
      "minLength": 1
     },
     "en_30_segundos": {
      "type": "string",
      "minLength": 1
     }
    },
    "additionalProperties": false
   }
  },
  "sin_resumen": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "intentos"
    ],
    "properties": {
     "intentos": {
      "type": "integer"
     },
     "fuente_url": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  }
 }
}
